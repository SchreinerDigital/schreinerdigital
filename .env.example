# ---------------------------------------------------------------------------
# SchreinerDigital – Beispiel-Umgebungsvariablen
#
# Kopieren nach `.env.local` und mit echten Werten füllen.
# `.env.local` ist in .gitignore und darf NICHT committet werden.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
# Öffentliche Basis-URL (für Metadaten, OAuth-Redirects, Stripe-Callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Analytics -------------------------------------------------------
# GA4-Messgruppen-ID: https://analytics.google.com/ → Verwaltung → Datenstreams
# Lädt nur, wenn Besucher der Statistik-Kategorie im Cookie-Banner zustimmen.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Brevo (Newsletter) ----------------------------------------------------
# API-Key: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-xxx

# Liste, in die bestätigte Kontakte einsortiert werden:
# https://app.brevo.com/contact/list -> Liste öffnen -> ID steht in der URL
BREVO_LIST_ID=1

# Transaktions-Vorlage für die Bestätigungs-Mail (Double-Opt-in):
# https://app.brevo.com/templates -> Vorlage erstellen -> ID steht in der URL
BREVO_DOI_TEMPLATE_ID=1

# --- Supabase -------------------------------------------------------------
# Projekt-Einstellungen: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Nur serverseitig verwenden – niemals an den Client geben, niemals committen.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: direkter DB-Zugriff (Migrationen, Drizzle/Prisma o. Ä.)
# SUPABASE_DB_URL=postgresql://postgres:[password]@db.YOUR-PROJECT-ref.supabase.co:5432/postgres

# --- Stripe --------------------------------------------------------------
# API-Keys: https://dashboard.stripe.com/apikeys  (Test-Modus verwenden)
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Webhook-Signaturschlüssel: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Preis-IDs aus dem Stripe-Katalog (Einmalkauf jetzt, Abo später)
# STRIPE_PRICE_EINMALKAUF=price_xxx
# STRIPE_PRICE_ABO_MONATLICH=price_xxx
